# 统一换行与文件属性（消除 Windows 下 LF/CRLF 警告）
* text=auto

*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

*.bat  text eol=crlf
*.ps1  text eol=crlf

*.png  binary
*.jpg  binary
*.ico  binary
*.exe  binary
*.pyd  binary
*.dll  binary
